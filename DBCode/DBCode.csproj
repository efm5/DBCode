<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows7.0</TargetFramework>
     <LangVersion>14</LangVersion>
     <Nullable>enable</Nullable>
     <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Icons\DBCodeIcon.ico</ApplicationIcon>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyVersion>0.0.0.2</AssemblyVersion>
    <FileVersion>0.0.0.2</FileVersion>
    <Company>EFM5</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;IDE0018;IDE0031;IDE0044;IDE0059;IDE0079;IDE0074;IDE0305;NETSDK1138;SYSLIB1045</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;IDE0018;IDE0031;IDE0044;IDE0059;IDE0079;IDE0074;IDE0305;NETSDK1138;SYSLIB1045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ProjectAssets\Help\**" />
    <EmbeddedResource Remove="ProjectAssets\Help\**" />
    <None Remove="ProjectAssets\Help\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icons\DBCodeIcon.ico" />
  </ItemGroup>

  <ItemGroup>
     <EmbeddedResource Include="Icons\CurlyTargetedIcon.ico" />
     <EmbeddedResource Include="Icons\CurlyUntargetedIcon.ico" />
    <EmbeddedResource Include="Icons\StatusTargetedIcon.ico" />
     <EmbeddedResource Include="Icons\StatusUntargetedIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="ProjectAssets\DBCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PCRE.NET" Version="1.4.1" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="call &quot;$(ProjectDir)..\successfulCompile.bat&quot;" />
  </Target>

</Project>
